# [VI] Ví dụ schema YAML version 1; x/z trải trên mặt đất, y là độ cao so với góc neo.
# [EN] Example version 1 YAML schema; x/z span the ground and y is height from the anchor corner.
schema-version: 1
name: "Bệ đá nhỏ"
blocks:
  - x: 0
    y: 0
    z: 0
    material: STONE_BRICKS
  - x: 1
    y: 0
    z: 0
    material: STONE_BRICKS
  - x: 2
    y: 0
    z: 0
    material: STONE_BRICKS
  - x: 0
    y: 0
    z: 1
    material: STONE_BRICKS
  - x: 1
    y: 0
    z: 1
    material: POLISHED_ANDESITE
  - x: 2
    y: 0
    z: 1
    material: STONE_BRICKS
  - x: 0
    y: 0
    z: 2
    material: STONE_BRICKS
  - x: 1
    y: 0
    z: 2
    material: STONE_BRICKS
  - x: 2
    y: 0
    z: 2
    material: STONE_BRICKS
